{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guidepilot.local/schemas/grounding.schema.json",
  "title": "GroundingResult",
  "description": "Model answer to 'where is this control?'. Coordinates must declare a supported coordinate space; GuidePilot maps them to physical screen pixels and independently re-checks them against accessibility data before highlighting.",
  "type": "object",
  "required": ["target_found", "confidence"],
  "additionalProperties": false,
  "properties": {
    "target_found": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "label": { "type": "string", "maxLength": 200 },
    "element_role": { "type": "string", "maxLength": 60 },
    "bounding_box": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "coordinate_space": {
      "type": "string",
      "enum": ["physical_screen", "capture_pixels", "normalized_image"]
    },
    "reasoning": { "type": "string", "maxLength": 600 },
    "visible_text": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "maxItems": 40 }
  },
  "dependentRequired": {
    "bounding_box": ["coordinate_space"]
  }
}
