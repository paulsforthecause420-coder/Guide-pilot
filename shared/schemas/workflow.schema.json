{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guidepilot.local/schemas/workflow.schema.json",
  "title": "Workflow",
  "description": "A reusable procedure saved from a completed task. Workflows never contain credentials, screen pixels or secrets.",
  "type": "object",
  "required": ["name", "version", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "maxLength": 80 },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "maxLength": 800 },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "integer" },
    "updated_at": { "type": "integer" },
    "objective": { "type": "string", "maxLength": 1000 },
    "app_hint": { "type": "string", "maxLength": 200 },
    "tags": { "type": "array", "items": { "type": "string", "maxLength": 40 }, "maxItems": 12 },
    "fingerprint": { "type": "string", "maxLength": 200 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": ["title", "instruction", "action_type", "expected_result"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "instruction": { "type": "string", "minLength": 1, "maxLength": 600 },
          "action_type": {
            "type": "string",
            "enum": ["click", "type", "select", "check", "scroll", "command", "confirm", "observe", "manual"]
          },
          "target_description": { "type": "string", "maxLength": 200 },
          "target_role": { "type": "string", "maxLength": 60 },
          "text_template": { "type": "string", "maxLength": 4000 },
          "expected_result": { "type": "string", "maxLength": 400 },
          "why": { "type": "string", "maxLength": 800 },
          "verification": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": { "type": "string", "maxLength": 60 },
                "params": { "type": "object" },
                "required": { "type": "boolean" },
                "description": { "type": "string", "maxLength": 300 }
              }
            }
          }
        }
      }
    }
  }
}
